{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site-supabase",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_DATA_SOURCE=supabase&& npm run dev -- --port 5173 --strictPort"
      ],
      "port": 5173,
      "url": "http://localhost:5173"
    },
    {
      "name": "dist-preview",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "npm run preview -- --port 4173 --strictPort"],
      "port": 4173,
      "url": "http://localhost:4173"
    },
    {
      "name": "site-sheet",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set VITE_DATA_SOURCE=sheet&& npm run dev -- --port 5175 --strictPort"],
      "port": 5175,
      "url": "http://localhost:5175"
    }
  ]
}
