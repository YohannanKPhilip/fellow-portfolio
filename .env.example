# Copy this file to .env.local for local development.
# On GitHub, set the same names under Settings > Secrets and variables > Actions > Variables.

# The long ID in your Google Sheet's address:
# https://docs.google.com/spreadsheets/d/<THIS PART>/edit
# Leave empty to run with the bundled sample data.
VITE_SHEET_ID=1SuHv0vo_1yoN4VO6zY7mOK68f4W07HB28aGDoCIzTLI

# The fellow shown on the home page (a fellow_id from the "fellows" tab).
VITE_DEFAULT_FELLOW=yohannan

# Path the site is served from. "/fellow-portfolio/" for GitHub Pages.
# Use "/" for a custom domain.
VITE_BASE=/fellow-portfolio/
